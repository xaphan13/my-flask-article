{
  "tools": {
    "approvalMode": "auto-edit"
  },
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python *)",
      "Bash(cd *)",
      "Bash(tail *)",
      "Bash(do)",
      "Bash(set *)",
      "Bash(done)",
      "Bash(diff *)",
      "Bash(sed *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(node *)",
      "Bash(rm *)",
      "Bash(uv *)"
    ]
  },
  "$version": 4
}
